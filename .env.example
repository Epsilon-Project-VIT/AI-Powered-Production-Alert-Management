# Google Gemini Configuration
# Obtain your API key from Google AI Studio (https://aistudio.google.com/)
# DO NOT commit .env file with real credentials
GEMINI_API_KEY=your_actual_key_here

# Model identifier (e.g., gemini-flash-latest, gemini-3.8-flash, gemini-pro-latest)
GEMINI_MODEL=gemini-flash-latest

# Optional: Enable/disable Gemini (default: false)
GEMINI_ENABLED=false

# Optional: Request timeout in seconds (default: 30)
GEMINI_TIMEOUT_SECONDS=30

# Optional: Maximum retries for retryable errors (default: 2)
GEMINI_MAX_RETRIES=2

# Optional: Sampling temperature (default: 0.0 for deterministic)
GEMINI_TEMPERATURE=0.0

# Optional: Maximum output tokens (default: 4096)
GEMINI_MAX_TOKENS=4096

# Optional: Proactive rate limit in requests per minute (default: 15)
GEMINI_RPM_LIMIT=15

# NVIDIA NIM Configuration
# DO NOT commit .env file with real credentials

# Required: NVIDIA API key (obtain from https://build.nvidia.com/)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Required: Model identifier (GLM-5.3 Flash)
NVIDIA_NIM_MODEL=z-ai/glm-5.3-flash

# Optional: NIM API base URL (default: https://integrate.api.nvidia.com/v1)
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional: Enable/disable NIM (default: false)
NVIDIA_NIM_ENABLED=false

# Optional: Request timeout in seconds (default: 30)
NVIDIA_NIM_TIMEOUT_SECONDS=30

# Optional: Maximum retries for retryable errors (default: 3)
NVIDIA_NIM_MAX_RETRIES=3

# Optional: Sampling temperature (default: 0.0 for deterministic)
NVIDIA_NIM_TEMPERATURE=0.0

# Optional: Maximum output tokens (default: 4096)
NVIDIA_NIM_MAX_TOKENS=4096

# Stage 4 Reasoning Provider Configuration
# Options: mock, gemini, nim
# Default: mock (so tests don't require API key)
REASONING_PROVIDER=mock
